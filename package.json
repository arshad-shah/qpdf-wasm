{
  "name": "@arshad-shah/qpdf-wasm",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "qpdf compiled to WebAssembly with a typed browser and Node API",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./qpdf.wasm": "./dist/qpdf.wasm"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES",
    "README.md"
  ],
  "scripts": {
    "sources": "node scripts/sources.mjs",
    "build:wasm": "node scripts/build.mjs",
    "build:ts": "tsc",
    "build": "pnpm build:wasm && pnpm build:ts",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.55.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/qpdf-wasm.git"
  },
  "homepage": "https://github.com/arshad-shah/qpdf-wasm#readme",
  "bugs": {
    "url": "https://github.com/arshad-shah/qpdf-wasm/issues"
  },
  "author": "Arshad Shah",
  "keywords": [
    "qpdf",
    "pdf",
    "wasm",
    "webassembly",
    "encryption",
    "aes-256",
    "optimize"
  ],
  "sideEffects": false
}
